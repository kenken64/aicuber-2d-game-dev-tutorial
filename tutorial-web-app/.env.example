# Set an OpenRouter key to send text/design requests directly to OpenRouter.
# The key stays on the server.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional API base override (normally leave this at the default).
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Optional OpenAI image and storyline voice configuration.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Optional override for the public DigitalOcean Spaces starter ZIP URL.
# Without this, the server serves a local build when present or redirects to the published Spaces ZIP.
GODOT_STARTER_KIT_URL=

# Tutorial origin allowed to embed student editor instances.
GODOT_CLOUD_APP_ORIGIN=https://learn-game.kere.ceo
# Optional exact origins for embedding from local development; leave empty in production.
GODOT_CLOUD_EXTRA_FRAME_ORIGINS=

GODOT_PROVISION_ENABLED=false
GODOT_PROVISION_PYTHON=python3
# AWS credentials use the server AWS CLI chain (environment/profile/role)
# or the ignored godot-cloud/.env.aws file; never enter AWS keys in the browser.

# Dynamic student subdomains are managed by Porkbun by default.
# Enable API Access for your domain in Porkbun, and keep these keys server-side.
GODOT_DNS_PROVIDER=porkbun
GODOT_DNS_DOMAIN=kere.ceo
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=

# AI CUBER marketplace: leave unconfigured for standalone local development.
# Production marketplace deployments must enable this and supply all values.
MARKETPLACE_AUTH_REQUIRED=false
APP_ORIGIN=
GAME_DEV_TUTORIAL_SESSION_SECRET=
MARKETPLACE_LAUNCH_VERIFY_URL=
MARKETPLACE_LAUNCH_VERIFY_SECRET=
